# ==========================================
# Database Configuration (Neon PostgreSQL)
# ==========================================
# Get your connection string from https://console.neon.tech
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ==========================================
# Clerk Authentication Configuration
# ==========================================
# Get your Clerk keys from https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY="pk_test_sample_clerk_publishable_key"
CLERK_SECRET_KEY="sk_test_sample_clerk_secret_key"

# ==========================================
# Inngest Background Jobs Configuration
# ==========================================
# Local dev runs without keys. For production, get keys from https://app.inngest.com
INNGEST_EVENT_KEY="test_inngest_event_key"
INNGEST_SIGNING_KEY="signkey-test_sample"

# ==========================================
# Brevo Email Service (Invitations & Task Assignment Notifications)
# ==========================================
# Get your API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY="xkeysib-your_brevo_api_key_here"
BREVO_SENDER_EMAIL="your-verified-sender@domain.com"

# ==========================================
# Application URL (Used in Brevo emails & redirects)
# ==========================================
# Set to your production domain on Vercel (e.g. https://nexus-pm.vercel.app)
APP_URL="http://localhost:5173"

# ==========================================
# Server Configuration
# ==========================================
PORT=5000
NODE_ENV=development
