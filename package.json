{
  "name": "project-management-system",
  "version": "1.0.0",
  "description": "Modern Project Management System built with React, Vite, Tailwind CSS, Express, Neon PostgreSQL, Clerk, and Inngest",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"bgBlue.bold,bgGreen.bold\" \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "npm run dev --prefix client",
    "build": "npm run client:build && prisma generate",
    "client:build": "npm run build --prefix client",
    "client:install": "npm install --prefix client",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "node server/seed.js",
    "vercel-build": "npm install --prefix client && npm run build --prefix client && prisma generate"
  },
  "dependencies": {
    "@clerk/backend": "^1.24.1",
    "@prisma/client": "^6.4.1",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "inngest": "^3.31.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9",
    "prisma": "^6.4.1"
  }
}
